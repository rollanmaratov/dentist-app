# Copy to .env.local (git-ignored) and fill in from Supabase Dashboard → Project Settings → API Keys.
# Only the URL and the *publishable* key belong in the app. Never put the database password
# or a secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
